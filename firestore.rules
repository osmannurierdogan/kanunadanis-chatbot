rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid
        && !('creditsRemaining' in request.resource.data)
        && !('stripeCustomerId' in request.resource.data)
        && !('plan' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('subscriptionStatus' in request.resource.data)
        && !('creditsResetAt' in request.resource.data);
    }

    match /chats/{chatId} {
      allow read, write: if request.auth.uid == resource.data.userId;
    }
  }
}
